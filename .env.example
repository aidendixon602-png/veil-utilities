# ==============================================================================
#  veil utilities — environment configuration
#
#  Copy this file to `.env` and fill in the values. Never commit `.env`.
#  Only the two values under "Required" are needed to start the bot.
# ==============================================================================


# ------------------------------------------------------------------------------
#  Required
# ------------------------------------------------------------------------------

# Bot token from https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=

# Discord user IDs of the bot developers, comma-separated.
# Developers can use the Secret commands and approve servers.
OWNER_IDS=


# ------------------------------------------------------------------------------
#  General
# ------------------------------------------------------------------------------

# Default command prefix (each server can change its own with `prefix set`)
PREFIX=,

# Text shown in the bot's "Watching …" status
STATUS=veil utilities | ,help

# Path to the SQLite database file
DB_PATH=veil.db

# Reduce cache sizes and image limits for low-memory hosts (recommended on 512 MB plans)
LOW_MEMORY=false


# ------------------------------------------------------------------------------
#  Server authorization
# ------------------------------------------------------------------------------

# Leave any server that a developer has not approved
AUTH_REQUIRED=true

# Channel ID that receives alerts when an unapproved server adds the bot.
# Developers are notified by DM regardless.
AUTH_LOG_CHANNEL=

# On first launch, automatically approve every server the bot is already in
AUTH_GRANDFATHER=true

# Support link shown to unapproved servers
SUPPORT_URL=


# ------------------------------------------------------------------------------
#  Monitoring
# ------------------------------------------------------------------------------

# Channel ID that receives a full traceback whenever a command fails
ERROR_LOG_CHANNEL=

# Log file used by `botlogs` (rotates at 5 MB, keeps 3 backups)
LOG_FILE=veil.log

# Notify developers by DM whenever antinuke is triggered in any server
ANTINUKE_DEV_ALERTS=true


# ------------------------------------------------------------------------------
#  Integrations (optional — leave blank to disable)
# ------------------------------------------------------------------------------

# Last.fm — https://www.last.fm/api/account/create
LASTFM_API_KEY=

# AI chat for `ask` and `summarize` — any OpenAI-compatible API
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Text recognition for `ocr` — https://ocr.space/ocrapi
OCR_SPACE_API_KEY=

# Image generation (`imagine`) and text-to-speech (`tts`) require no key.


# ------------------------------------------------------------------------------
#  Music (optional)
# ------------------------------------------------------------------------------

# Lavalink v4 server address, e.g. http://localhost:2333 — leave blank to disable music
LAVALINK_URI=

# Must match the password in lavalink/application.yml
LAVALINK_PASSWORD=youshallnotpass
