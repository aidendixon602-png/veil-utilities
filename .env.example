# Copy to .env and fill in. Never commit .env.
# Every setting is documented and validated in core/config.py.

# --- Required ----------------------------------------------------------------
DISCORD_TOKEN=

# Developers are found automatically: the owner (or every team member) of your bot's Discord application.
# Only list IDs here to add extra developers (comma-separated user IDs).
# OWNER_IDS=

# --- General -----------------------------------------------------------------
PREFIX=,
# The status always reads "Protecting X guilds | Y users" (developers can override it with ,setstatus)
# Bot presence state: online, dnd (Do Not Disturb), idle, or invisible
BOT_STATUS=online
# Where the bot keeps its data. SQLite by default (one file, nothing to set up).
DB_PATH=veil.db
# For a large deployment, point DATABASE_URL at PostgreSQL instead and DB_PATH is ignored.
# Tables are created on first start. Switching databases does not migrate existing data; back up first.
# DATABASE_URL=postgresql://user:password@localhost:5432/veil

# This example explicitly disables low-memory mode. Remove the setting for automatic small-container detection,
# or set it to true to force low-memory mode.
LOW_MEMORY=false

# --- Server authorization ----------------------------------------------------
AUTH_REQUIRED=true
# true = a private bot: only developers, server owners and people with a permission level can run commands
# (everyone else, and DMs, are ignored without a reply). Set false to let every member use public commands.
PRIVATE_MODE=true
# Unauthorized joins are queued for developer DMs. A private #veil-auth channel is created when possible;
# set a channel ID here to use an existing channel instead. Delivery and leave attempts can fail.
# AUTH_LOG_CHANNEL=
# On an uninitialized authorization database, true enrolls already-joined servers once.
# For an existing empty list, set false before upgrading if that list is intentionally empty.
AUTH_GRANDFATHER=true
SUPPORT_URL=

# --- Monitoring --------------------------------------------------------------
# Command-error tracebacks can go to a private #veil-errors channel when the bot can create one.
# Set a channel ID here only to use a channel of your own instead.
# ERROR_LOG_CHANNEL=
LOG_FILE=veil.log
ANTINUKE_DEV_ALERTS=true
# ,testnuke / ,testcleanup / ,testserver only work for the developer IDs listed in OWNER_IDS above.
# The test server is picked in Discord (the first confirmed ,testnuke, or ,testserver set); set an ID here
# only to pin it.
# TEST_GUILD_ID=

# --- AI (optional: works with no key) ------------------------------------------
# Leave AI_API_KEY empty to use a free no-signup AI (slower). For faster, smarter answers paste ONE key —
# the provider and model are detected automatically, no other settings needed:
#   Groq   (free, no card)  https://console.groq.com/keys          key starts with gsk_
#   Gemini (free tier)      https://aistudio.google.com/apikey     key starts with AIza
#   OpenRouter (free models) https://openrouter.ai/keys            key starts with sk-or-
#   OpenAI (paid)           https://platform.openai.com/api-keys   key starts with sk-
AI_API_KEY=
# Optional overrides: a custom OpenAI-compatible endpoint (e.g. Ollama http://localhost:11434/v1) / exact model
AI_BASE_URL=
AI_MODEL=

# --- Other integrations (optional) ----------------------------------------------
# OCR works without a key (shared demo key, rate-limited); a free personal key: https://ocr.space/ocrapi/freekey
OCR_SPACE_API_KEY=
# Last.fm commands (,np ,lf ...): free key at https://www.last.fm/api/account/create
LASTFM_API_KEY=
# Spotify search comes from Deezer without keys. Real Spotify data: https://developer.spotify.com/dashboard
# (Spotify now requires the app owner to have Spotify Premium)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Twitch live alerts in ,feeds: free app at https://dev.twitch.tv/console/apps (YouTube/Reddit/SoundCloud/RSS need nothing)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Instagram / TikTok / X feeds go through RSSHub; the public one is often blocked, a self-hosted one works best
RSSHUB_URL=https://rsshub.app

# --- Music (optional: availability depends on a working Lavalink node) ---------
# Empty = free public Lavalink nodes with automatic failover. Your own Lavalink 4.2+ server(s):
# LAVALINK_URI=http://localhost:2333   (comma-separate several nodes, and their passwords)
LAVALINK_URI=
# Empty uses Lavalink's public example default. Use a unique secret for a private node.
LAVALINK_PASSWORD=
# With LAVALINK_URI set, the public nodes stay connected as backups for when yours is down (false = yours only)
LAVALINK_BACKUPS=true
# Set to false to turn music off completely
MUSIC_ENABLED=true

# --- Web dashboard (optional: off by default) -----------------------------------
# Discord login is required: server owners manage their authorized servers, bot developers manage all servers and
# the server authorization list. Set the secret and public HTTPS origin before enabling. See docs/HOSTING.md.
# The default bind is 127.0.0.1 for a same-host HTTPS reverse proxy; don't expose the backend HTTP port publicly.
DASHBOARD_ENABLED=false
DASHBOARD_PORT=8080
# DASHBOARD_HOST=127.0.0.1
# Your bot's OAuth2 Client Secret (developer portal -> your app -> OAuth2). The Client ID is read from the bot itself.
# DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The public address people open, e.g. https://veil.example.com (add <DASHBOARD_URL>/callback as a redirect in the portal)
DASHBOARD_URL=
# Optional: 32+ random characters so logins survive restarts (empty = everyone is logged out on restart)
DASHBOARD_SECRET=
