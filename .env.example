# Required
DISCORD_TOKEN=your-bot-token-here

# Your Discord user ID(s), comma separated — unlocks owner commands
OWNER_IDS=

# Server authorization — the bot leaves any server a developer (OWNER_IDS) hasn't approved
AUTH_REQUIRED=true
# Channel ID where "someone tried to add the bot" alerts go (developers are DMed either way)
AUTH_LOG_CHANNEL=
# On the very first run, auto-approve every server the bot is already in
AUTH_GRANDFATHER=true
# Shown to unauthorized servers so they know where to ask
SUPPORT_URL=

# Channel ID that gets a full traceback whenever a command crashes (also see ,errors and ,error <id>)
ERROR_LOG_CHANNEL=
# Log file read by ,botlogs (rotates at 5MB, keeps 3 old files)
LOG_FILE=veil.log

# DM every developer a "Global antinuke alert" whenever antinuke fires in any server
ANTINUKE_DEV_ALERTS=true

# Set true on small hosts (e.g. Wispbyte's 512 MB free plan): smaller caches and image limits
LOW_MEMORY=false

# Optional
PREFIX=,
STATUS=veil utilities | ,help
DB_PATH=veil.db

# Last.fm (free key: https://www.last.fm/api/account/create)
LASTFM_API_KEY=

# AI chat (,ask / ,summarize) — any OpenAI-compatible provider: OpenAI, OpenRouter, Groq, local Ollama…
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# OCR (,ocr) — free key at https://ocr.space/ocrapi
OCR_SPACE_API_KEY=
# Image generation (,imagine) and text-to-speech (,tts) need no key

# Music — point at a Lavalink v4 server (see lavalink/application.yml)
LAVALINK_URI=
LAVALINK_PASSWORD=youshallnotpass
