# Copy to .env and fill in. Never commit .env.
# Every setting is documented and validated in core/config.py.

# --- Required ----------------------------------------------------------------
DISCORD_TOKEN=

# Comma-separated developer user IDs
OWNER_IDS=

# --- General -----------------------------------------------------------------
PREFIX=,
STATUS=veil utilities | ,help
DB_PATH=veil.db

# Set to true on hosts with 512 MB RAM or less
LOW_MEMORY=false

# --- Server authorization ----------------------------------------------------
AUTH_REQUIRED=true
AUTH_LOG_CHANNEL=
AUTH_GRANDFATHER=true
SUPPORT_URL=

# --- Monitoring --------------------------------------------------------------
ERROR_LOG_CHANNEL=
LOG_FILE=veil.log
ANTINUKE_DEV_ALERTS=true

# --- Integrations (optional) -------------------------------------------------
LASTFM_API_KEY=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
OCR_SPACE_API_KEY=

# --- Music (optional) --------------------------------------------------------
LAVALINK_URI=
LAVALINK_PASSWORD=youshallnotpass
